{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Start FastAPI",
            "type": "shell",
            "command": "$env:GEMINI_API_KEY = ((Get-Content .env | Select-String 'GEMINI_API_KEY').ToString().Split('=')[1]).Trim(); python -m uvicorn app.main:app --reload --port 8000",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "close": false,
                "focus": false
            }
        },
        {
            "label": "2. Start Streamlit",
            "type": "shell",
            "command": "$env:API_URL = 'http://localhost:8000'; python -m streamlit run streamlit_app.py --server.port 8501",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "close": false,
                "focus": true
            }
        }
    ]
}
